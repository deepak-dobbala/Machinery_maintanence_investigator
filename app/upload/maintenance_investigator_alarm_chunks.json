      "chunk_type": "alarm",
      "alarm_number": 121,
      "alarm_text": "Low Lube or Low Pressure",
      "subsystem": "lubrication",
      "manual_page_start": 58,
      "manual_page_end": 58,
      "pdf_page_start_1based": 58,
      "pdf_page_end_1based": 58,
