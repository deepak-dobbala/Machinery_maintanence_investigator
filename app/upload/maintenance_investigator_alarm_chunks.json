      "extraction_quality": "good",
      "source_extraction": "pdftotext",
      "technical_purpose": "Low/incorrect way-lube pressure or level",
      "text": "121 Low Lube or Low Pressure\nWay lube is low or empty or there is no lube pressure or too high\na pressure. Check tank at rear of mill and below control cabinet.\nAlso check connector on the side of the control cabinet. Check\nthat the lube lines are not blocked.",
      "revision_group": "vf_alarm_121",
      "is_revision_pair": true
    },
