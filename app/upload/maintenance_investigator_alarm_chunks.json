      "source_extraction": "pdftotext",
      "technical_purpose": "Emergency stop or hydraulic counterbalance pressure condition",
      "text": "107 Emergency Off\nEMERGENCY STOP button was pressed. After the E-STOP is\nreleased, the RESET button must be pressed once to correct\nthis and clear the E-STOP alarm.\nThis alarm will also be generated if there is a low pressure\ncondition in the hydraulic counterbalance system. In this case,\nthe alarm will not reset until the condition has been corrected.",
      "revision_group": "vf_alarm_107",
      "is_revision_pair": true
    },
