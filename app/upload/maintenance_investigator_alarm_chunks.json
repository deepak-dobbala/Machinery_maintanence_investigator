      "has_bullets": false,
      "extraction_quality": "good",
      "source_extraction": "pdftotext",
      "technical_purpose": "Spindle drive, motor, or regenerative-load fault",
      "text": "123 Spindle Drive Fault\nFailure of spindle drive, motor or regen load. This can be caused\nby a shorted motor, overvoltage, overcurrent, undervoltage, failure\nof drive, or shorted or open regen load. Undervoltage and\novervoltage of DC bus are also reported as alarms 160 and 119,\nrespectively.",
      "revision_group": "vf_alarm_123",
      "is_revision_pair": true
    }
