      "alarm_number": 116,
      "alarm_text": "Spindle Orientation Fault",
      "subsystem": "spindle",
      "manual_page_start": 57,
      "manual_page_end": 57,
      "pdf_page_start_1based": 57,
      "pdf_page_end_1based": 57,
      "source_role": "revision_reference",
      "revision_priority": 2,
      "has_table": false,
      "has_diagram": false,
      "has_bullets": false,
      "extraction_quality": "good",
      "source_extraction": "pdftotext",
      "technical_purpose": "Spindle failed to orient",
      "text": "116 Spindle Orientation Fault\nSpindle did not orient correctly. This is either a vector drive\nproblem or a mechanical problem on machines without a vector\ndrive. During a spindle orientation function, the spindle is\nrotated until the lock pin drops in; but the lock pin never dropped.\nParameters 66, 70, 73, and 74 can adjust time-out timers. This\ncan be caused by a trip of circuit breaker CB4, a lack of air\npressure, or too much friction with the orientation pin.",
      "revision_group": "vf_alarm_116",
      "is_revision_pair": true
    },
    {
      "chunk_id": "vf_2001_revc_alarm_117",
