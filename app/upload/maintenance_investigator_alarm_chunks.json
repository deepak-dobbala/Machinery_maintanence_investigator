      "alarm_text": "Low Air Pressure",
      "subsystem": "pneumatic",
      "manual_page_start": 58,
      "manual_page_end": 58,
      "pdf_page_start_1based": 58,
      "pdf_page_end_1based": 58,
      "source_role": "revision_reference",
      "revision_priority": 2,
      "has_table": false,
      "has_diagram": false,
      "has_bullets": false,
      "extraction_quality": "good",
      "source_extraction": "pdftotext",
      "technical_purpose": "Low incoming machine air pressure",
      "text": "120 Low Air Pressure\nAir pressure dropped below 80 PSI for a period defined by\nParameter 76. The LOW AIR PR alarm will appear on the screen\nas soon as the pressure gets low, and this alarm appears after\nsome time has elapsed. Check your incoming air pressure for at\nleast 100 PSI and ensure that the regulator is set at 85 PSI.",
      "revision_group": "vf_alarm_120",
      "is_revision_pair": true
    },
