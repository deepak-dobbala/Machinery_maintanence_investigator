      "chunk_type": "alarm",
      "alarm_number": 117,
      "alarm_text": "Spindle High Gear Fault",
      "subsystem": "spindle/gearbox",
      "manual_page_start": 57,
      "manual_page_end": 57,
      "pdf_page_start_1based": 57,
      "pdf_page_end_1based": 57,
      "source_role": "revision_reference",
      "revision_priority": 2,
      "has_table": false,
      "has_diagram": false,
      "has_bullets": false,
      "extraction_quality": "good",
      "source_extraction": "pdftotext",
      "technical_purpose": "Gearbox failed to reach high gear",
      "text": "117 Spindle High Gear Fault\nGearbox did not shift into high gear. During a change to high\ngear, the spindle is rotated slowly while air pressure is used to\nmove the gears but the high gear sensor was not detected in\ntime. Parameters 67, 70 and 75 can adjust the time-out times.\nCheck the air pressure, circuit breaker CB4,the circuit breaker for\nthe air pressure solenoids, and the spindle drive.\n\n57\n\nALARMS\n\n58\n\nJune 2001",
      "revision_group": "vf_alarm_117",
      "is_revision_pair": true
    },
    {
      "chunk_id": "vf_2001_revc_alarm_118",
      "document_id": "96-8100",
