      "alarm_text": "Spindle Low Gear Fault",
      "subsystem": "spindle/gearbox",
      "manual_page_start": 58,
      "manual_page_end": 58,
      "pdf_page_start_1based": 58,
      "pdf_page_end_1based": 58,
      "source_role": "revision_reference",
      "revision_priority": 2,
      "has_table": false,
      "has_diagram": false,
      "has_bullets": false,
      "extraction_quality": "good",
      "source_extraction": "pdftotext",
      "technical_purpose": "Gearbox failed to reach low gear",
      "text": "118 Spindle Low Gear Fault\nGearbox did not shift into low gear. During a change to low gear,\nthe spindle is rotated slowly while air pressure is used to move\nthe gears but the low gear sensor was not detected in time.\nParameters 67, 70 and 75 can adjust the time-out times. Check\nthe air pressure, the solenoid's circuit breaker CB4, and the\nspindle drive.",
      "revision_group": "vf_alarm_118",
      "is_revision_pair": true
    },
