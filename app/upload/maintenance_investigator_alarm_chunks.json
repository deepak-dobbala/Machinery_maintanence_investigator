      "alarm_number": 107,
      "alarm_text": "Emergency Off",
      "subsystem": "safety/hydraulic",
      "manual_page_start": 57,
      "manual_page_end": 57,
      "pdf_page_start_1based": 57,
      "pdf_page_end_1based": 57,
      "source_role": "revision_reference",
      "revision_priority": 2,
      "has_table": false,
      "has_diagram": false,
      "has_bullets": false,
      "extraction_quality": "good",
      "source_extraction": "pdftotext",
      "technical_purpose": "Emergency stop or hydraulic counterbalance pressure condition",
      "text": "107 Emergency Off\nEMERGENCY STOP button was pressed. After the E-STOP is\nreleased, the RESET button must be pressed once to correct\nthis to clear the E-STOP alarm.\nThis alarm will also be generated if there is a low pressure\ncondition in the hydraulic counterbalance system. In this case,\nthe alarm will not reset until the condition has been corrected.\n\n96-8100 rev C\n\nALARMS\n\nJune 2001\n\n96-8100 rev C",
      "revision_group": "vf_alarm_107",
      "is_revision_pair": true
    },
    {
      "chunk_id": "vf_2001_revc_alarm_108",
      "document_id": "96-8100",
      "document_title": "VF Series Service Manual",
      "revision": "Rev C",
      "publication_date": "June 2001",
      "machine_family": "Haas VF Series",
      "section_number": "2",
      "section_title": "ALARMS",
      "chunk_type": "alarm",
      "alarm_number": 108,
      "alarm_text": "X Servo Overload",
      "subsystem": "axis/servo",
      "manual_page_start": 57,
      "manual_page_end": 57,
      "pdf_page_start_1based": 57,
      "pdf_page_end_1based": 57,
      "source_role": "revision_reference",
      "revision_priority": 2,
      "has_table": false,
      "has_diagram": false,
      "has_bullets": false,
      "extraction_quality": "good",
      "source_extraction": "pdftotext",
      "technical_purpose": "X-axis motor overload",
      "text": "108 X Servo Overload\nExcessive load on X-axis motor. This can occur if the load on the\nmotor over a period of several seconds or even minutes is large\nenough to exceed the continuous rating of the motor. The servos\nwill be turned off when this occurs. This can be caused by\nrunning into the mechanical stops but not much past them. It can\nalso be caused by anything that causes a very high load on the\nmotors.",
      "revision_group": "vf_alarm_108",
      "is_revision_pair": true
    },
